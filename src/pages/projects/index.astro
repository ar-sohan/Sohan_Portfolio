---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import ProjectIndex from "../../components/ProjectIndex.astro";

const projects = (await getCollection("projects")).sort(
  (a, b) => b.data.year - a.data.year || a.data.order - b.data.order,
);
---

<Base title="Projects" description="Selected projects, with what I built and how it turned out.">
  <PageHeader
    title="Projects"
    intro="Things I've designed, built and shipped. Open one to read what the problem was, what I did and how it turned out."
  />
  <section class="frame pb-20 md:pb-28">
    <ProjectIndex projects={projects} />
  </section>
</Base>
