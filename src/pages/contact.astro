---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Clock from "../components/Clock.astro";
import { contactForm, person, socials } from "../data/site";

const thanksUrl = new URL("/thanks", Astro.site).href;
const field =
  "mt-2 w-full rounded-xl border border-line bg-paper px-4 py-3 text-base text-ink placeholder:text-muted/70 transition-colors focus:border-ink focus:outline-none aria-[invalid=true]:border-red-500";
---

<Base title="Contact" description={`Get in touch with ${person.name}. ${contactForm.responseTime}`} hideCta>
  <section class="frame pb-20 pt-14 md:pb-28 md:pt-24">
    <div class="grid gap-14 lg:grid-cols-12 lg:gap-6">
      <!-- Contact details -->
      <div class="lg:col-span-5">
        <h1 class="display-l">Let's talk</h1>
        <p class="mt-6 max-w-[42ch] text-lg text-muted">
          Tell me about the role, the project or the idea. {contactForm.responseTime}
        </p>

        <dl class="mt-10 divide-y divide-line border-y border-line">
          <div class="py-4">
            <dt class="text-sm text-muted">Email</dt>
            <dd class="mt-0.5 flex items-center justify-between gap-4">
              <a href={`mailto:${person.email}`} class="link min-w-0 truncate">{person.email}</a>
              <button
                type="button"
                data-copy={person.email}
                class="inline-flex min-h-11 shrink-0 items-center gap-2 rounded-full border border-line px-4 text-sm transition-colors hover:border-ink"
              >
                <Icon name="copy" size={16} data-icon-copy />
                <Icon name="check" size={16} class="hidden" data-icon-done />
                <span aria-live="polite">Copy</span>
              </button>
            </dd>
          </div>
          {
            person.phone && (
              <div class="py-4">
                <dt class="text-sm text-muted">Phone</dt>
                <dd class="mt-0.5">
                  <a href={`tel:${person.phone.replace(/[^+\d]/g, "")}`} class="link">
                    {person.phone}
                  </a>
                </dd>
              </div>
            )
          }
          <div class="py-4">
            <dt class="text-sm text-muted">Location</dt>
            <dd class="mt-0.5">
              {person.city}. It's <Clock /> here.
            </dd>
          </div>
          {
            person.openToWork && (
              <div class="py-4">
                <dt class="text-sm text-muted">Availability</dt>
                <dd class="mt-0.5 flex items-start gap-2">
                  <span class="mt-2 size-2 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                  {person.availability}
                </dd>
              </div>
            )
          }
          <div class="py-4">
            <dt class="text-sm text-muted">Elsewhere</dt>
            <dd class="mt-2 flex flex-wrap gap-2">
              {
                socials.map((s) => (
                  <a
                    href={s.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex min-h-11 items-center gap-2 rounded-full border border-line px-4 text-[0.95rem] transition-colors hover:border-ink"
                  >
                    <Icon name={s.label} size={16} />
                    {s.label}
                  </a>
                ))
              }
            </dd>
          </div>
        </dl>
      </div>

      <!-- Form -->
      <div class="lg:col-span-6 lg:col-start-7">
        <form
          id="contact-form"
          action="https://api.web3forms.com/submit"
          method="POST"
          novalidate
          data-key={contactForm.web3formsKey}
          data-email={person.email}
          class="rounded-3xl border border-line bg-surface p-5 sm:p-8"
        >
          <input type="hidden" name="access_key" value={contactForm.web3formsKey} />
          <input type="hidden" name="from_name" value={`${person.name}'s portfolio`} />
          <input type="hidden" name="redirect" value={thanksUrl} />
          <!-- Spam trap: people never see or fill this -->
          <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

          <fieldset>
            <legend class="text-[0.95rem] font-medium">What's this about?</legend>
            <div class="mt-3 flex flex-wrap gap-2">
              {
                contactForm.topics.map((t, i) => (
                  <label class="cursor-pointer">
                    <input type="radio" name="topic" value={t} checked={i === 0} class="peer sr-only" />
                    <span class="inline-flex min-h-11 items-center rounded-full border border-line px-4 text-[0.95rem] transition-colors peer-checked:border-ink peer-checked:bg-ink peer-checked:text-paper peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-accent">
                      {t}
                    </span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <div class="mt-7 grid gap-5 sm:grid-cols-2">
            <div>
              <label for="cf-name" class="text-[0.95rem] font-medium">Your name</label>
              <input id="cf-name" name="name" required autocomplete="name" aria-describedby="cf-name-err" class={field} />
              <p id="cf-name-err" class="mt-1.5 hidden text-sm text-red-600 dark:text-red-400" data-error>Enter your name.</p>
            </div>
            <div>
              <label for="cf-email" class="text-[0.95rem] font-medium">Your email</label>
              <input
                id="cf-email"
                name="email"
                type="email"
                required
                autocomplete="email"
                aria-describedby="cf-email-err"
                class={field}
              />
              <p id="cf-email-err" class="mt-1.5 hidden text-sm text-red-600 dark:text-red-400" data-error>
                Enter an email I can reply to, like name@example.com.
              </p>
            </div>
          </div>

          <div class="mt-5">
            <label for="cf-message" class="text-[0.95rem] font-medium">Message</label>
            <textarea
              id="cf-message"
              name="message"
              required
              minlength="10"
              rows="6"
              placeholder="A few lines about what you have in mind, timelines, budget or links."
              aria-describedby="cf-message-err"
              class={`${field} resize-y`}></textarea>
            <p id="cf-message-err" class="mt-1.5 hidden text-sm text-red-600 dark:text-red-400" data-error>
              Write at least a sentence so I know how to help.
            </p>
          </div>

          <div class="mt-7 flex flex-wrap items-center gap-4">
            <button type="submit" class="btn-primary min-w-40" data-submit>
              <span data-label>Send message</span>
              <Icon name="arrow-right" size={18} />
            </button>
            <p class="text-sm text-muted" data-status role="status" aria-live="polite"></p>
          </div>
        </form>

        <!-- Shown after a successful send -->
        <div
          id="contact-success"
          hidden
          tabindex="-1"
          class="rounded-3xl border border-line bg-surface p-8 text-center outline-none sm:p-12"
        >
          <span class="mx-auto grid size-14 place-items-center rounded-full bg-accent text-accent-ink">
            <Icon name="check" size={28} />
          </span>
          <h2 class="mt-6 display-m">Message sent</h2>
          <p class="mx-auto mt-3 max-w-[40ch] text-muted">
            Thanks for writing. {contactForm.responseTime} A copy of your message is in my inbox now.
          </p>
          <button type="button" class="btn-ghost mt-8" data-reset>Send another message</button>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  function init() {
    // Copy email
    document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
      btn.onclick = async () => {
        try {
          await navigator.clipboard.writeText(btn.dataset.copy!);
        } catch {
          return void (location.href = `mailto:${btn.dataset.copy}`);
        }
        const label = btn.querySelector("span")!;
        btn.querySelector("[data-icon-copy]")!.classList.add("hidden");
        btn.querySelector("[data-icon-done]")!.classList.remove("hidden");
        label.textContent = "Copied";
        setTimeout(() => {
          btn.querySelector("[data-icon-copy]")!.classList.remove("hidden");
          btn.querySelector("[data-icon-done]")!.classList.add("hidden");
          label.textContent = "Copy";
        }, 2000);
      };
    });

    const form = document.getElementById("contact-form") as HTMLFormElement | null;
    const success = document.getElementById("contact-success");
    if (!form || !success) return;
    const status = form.querySelector<HTMLElement>("[data-status]")!;
    const submit = form.querySelector<HTMLButtonElement>("[data-submit]")!;
    const label = submit.querySelector<HTMLElement>("[data-label]")!;
    const fields = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("input[required], textarea[required]")];

    const check = (el: HTMLInputElement | HTMLTextAreaElement) => {
      const ok = el.checkValidity() && el.value.trim().length > 0;
      el.setAttribute("aria-invalid", String(!ok));
      document.getElementById(el.getAttribute("aria-describedby")!)?.classList.toggle("hidden", ok);
      return ok;
    };
    // Validate a field once the visitor leaves it, then live as they fix it
    fields.forEach((el) => {
      el.addEventListener("blur", () => el.value && check(el));
      el.addEventListener("input", () => el.getAttribute("aria-invalid") === "true" && check(el));
    });

    form.onsubmit = async (e) => {
      e.preventDefault();
      const bad = fields.filter((el) => !check(el));
      if (bad.length) return bad[0].focus();

      const data = new FormData(form);
      const topic = String(data.get("topic") ?? "Message");
      const name = String(data.get("name"));
      data.set("subject", `${topic}: new message from ${name}`);
      data.delete("redirect");

      // No email service connected yet: hand the message to the visitor's email app.
      if (!form.dataset.key) {
        const body = `${data.get("message")}\n\n${name}\n${data.get("email")}`;
        location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(String(data.get("subject")))}&body=${encodeURIComponent(body)}`;
        return;
      }

      submit.disabled = true;
      label.textContent = "Sending…";
      status.textContent = "";
      try {
        const res = await fetch(form.action, {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify(Object.fromEntries(data)),
        });
        const json = await res.json().catch(() => ({}));
        if (!res.ok || json.success === false) throw new Error(json.message || `Error ${res.status}`);
        form.hidden = true;
        success.hidden = false;
        success.focus();
        form.reset();
      } catch {
        status.innerHTML = "";
        status.append(
          "Your message didn't send. Check your connection and try again, or email ",
          Object.assign(document.createElement("a"), {
            href: `mailto:${form.dataset.email}`,
            textContent: form.dataset.email,
            className: "link text-ink",
          }),
          ".",
        );
      } finally {
        submit.disabled = false;
        label.textContent = "Send message";
      }
    };

    success.querySelector<HTMLButtonElement>("[data-reset]")!.onclick = () => {
      success.hidden = true;
      form.hidden = false;
      form.querySelector<HTMLInputElement>("#cf-name")?.focus();
    };
  }
  document.addEventListener("astro:page-load", init);
</script>
