---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Clock from "../components/Clock.astro";
import ProjectIndex from "../components/ProjectIndex.astro";
import { about, experience, person } from "../data/site";

const featured = (await getCollection("projects", (p) => p.data.featured)).sort(
  (a, b) => a.data.order - b.data.order,
);
const current = experience[0];
const letters = [...person.name];
---

<Base>
  <!-- Hero -->
  <section class="frame pb-0 pt-10 md:pt-16">
    <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 text-[0.95rem] text-muted">
      {
        person.openToWork ? (
          <p class="inline-flex items-center gap-2 text-ink">
            <span class="relative flex size-2.5" aria-hidden="true">
              <span class="absolute inline-flex size-full animate-ping rounded-full bg-accent opacity-60 motion-reduce:hidden" />
              <span class="relative inline-flex size-2.5 rounded-full bg-accent" />
            </span>
            Available for work
          </p>
        ) : (
          <span />
        )
      }
      <p>{person.role}</p>
    </div>

    <h1 class="display-xl mt-6 md:mt-10" aria-label={person.name}>
      {
        letters.map((ch, i) => (
          <span class="hero-letter inline-block" style={`--i:${i}`} aria-hidden="true">
            {ch === " " ? " " : ch}
          </span>
        ))
      }
    </h1>

    <div class="mt-10 grid gap-8 pb-14 md:mt-14 md:grid-cols-12 md:gap-6 md:pb-20">
      <p class="display-m font-medium md:col-span-7">{person.tagline}</p>
      <div class="flex flex-col gap-7 md:col-span-4 md:col-start-9 md:pt-2">
        <p class="text-muted">{person.intro}</p>
        <div class="flex flex-wrap gap-3">
          <a href="/projects" class="btn-primary">See my projects</a>
          <a href="/contact" class="btn-ghost">Get in touch</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Facts strip -->
  <section class="border-y border-line" aria-label="At a glance">
    <dl class="frame grid sm:grid-cols-3 sm:divide-x sm:divide-line">
      <div class="border-b border-line py-5 sm:border-b-0 sm:px-6 sm:first:pl-0">
        <dt class="text-sm text-muted">Based in</dt>
        <dd class="mt-1">{person.city}, <Clock /></dd>
      </div>
      <div class="border-b border-line py-5 sm:border-b-0 sm:px-6">
        <dt class="text-sm text-muted">Currently</dt>
        <dd class="mt-1">{current ? `${current.role} at ${current.company}` : "Freelancing"}</dd>
      </div>
      <div class="py-5 sm:px-6">
        <dt class="text-sm text-muted">{about.now[0]?.label ?? "Focus"}</dt>
        <dd class="mt-1">{about.now[0]?.text ?? person.role}</dd>
      </div>
    </dl>
  </section>

  <!-- Selected work -->
  <section class="frame py-20 md:py-28" aria-labelledby="work-title">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-4 md:mb-14">
      <h2 id="work-title" class="display-l">Selected work</h2>
      <a href="/projects" class="link inline-flex items-center gap-1.5 text-[0.95rem]">
        All projects <Icon name="arrow-right" size={16} />
      </a>
    </div>
    <ProjectIndex projects={featured} />
  </section>

  <!-- Short intro + links into the other pages -->
  <section class="frame pb-20 md:pb-28" aria-labelledby="hello-title">
    <div class="grid gap-10 border-t border-line pt-10 md:grid-cols-12 md:gap-6">
      <h2 id="hello-title" class="display-m md:col-span-4">A bit about me</h2>
      <div class="space-y-5 text-lg md:col-span-7 md:col-start-6">
        <p>{about.paragraphs[0]}</p>
        <div class="flex flex-wrap gap-x-8 gap-y-3 pt-2 text-[0.95rem]">
          <a href="/about" class="link inline-flex items-center gap-1.5">More about me <Icon name="arrow-right" size={16} /></a>
          <a href="/experience" class="link inline-flex items-center gap-1.5">My experience <Icon name="arrow-right" size={16} /></a>
          {
            person.resumeUrl && (
              <a href={person.resumeUrl} target="_blank" rel="noopener" class="link inline-flex items-center gap-1.5">
                Download CV <Icon name="download" size={16} />
              </a>
            )
          }
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* The one orchestrated moment: the name rises in, letter by letter, on first load */
  .hero-letter {
    animation: rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(var(--i) * 45ms);
  }
  @keyframes rise {
    from {
      transform: translateY(0.35em);
      opacity: 0;
      filter: blur(6px);
    }
  }
</style>
