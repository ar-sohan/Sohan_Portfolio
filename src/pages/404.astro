---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" noindex>
  <section class="frame py-24 md:py-36">
    <p class="display-xl text-line" aria-hidden="true">404</p>
    <h1 class="display-m mt-6">This page doesn't exist</h1>
    <p class="mt-4 max-w-[48ch] text-lg text-muted">
      The link may be old or mistyped. Try the home page or the projects list.
    </p>
    <div class="mt-10 flex flex-wrap gap-3">
      <a href="/" class="btn-primary">Go to home</a>
      <a href="/projects" class="btn-ghost">See projects</a>
    </div>
  </section>
</Base>
