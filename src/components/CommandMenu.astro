---
import { getCollection } from "astro:content";
import Icon from "./Icon.astro";
import { nav, person, socials } from "../data/site";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);

type Item = { group: string; label: string; hint?: string; href?: string; action?: string; external?: boolean };
const items: Item[] = [
  ...nav.map((n) => ({ group: "Pages", label: n.label, href: n.href })),
  ...projects.map((p) => ({ group: "Projects", label: p.data.title, hint: p.data.type, href: `/projects/${p.id}` })),
  { group: "Actions", label: "Copy email address", hint: person.email, action: "copy-email" },
  { group: "Actions", label: "Switch theme", action: "theme" },
  ...(person.resumeUrl ? [{ group: "Actions", label: "Download CV", href: person.resumeUrl, external: true }] : []),
  ...socials.map((s) => ({ group: "Elsewhere", label: s.label, hint: s.handle, href: s.href, external: true })),
];
const groups = [...new Set(items.map((i) => i.group))];
---

<dialog
  id="command-menu"
  aria-label="Quick menu"
  class="m-auto mt-[12vh] w-[min(36rem,calc(100%-2rem))] overflow-hidden rounded-2xl border border-line bg-surface p-0 text-ink shadow-2xl backdrop:bg-ink/30 backdrop:backdrop-blur-[2px]"
  data-email={person.email}
>
  <div class="flex items-center gap-3 border-b border-line px-4">
    <Icon name="search" size={18} class="text-muted" />
    <input
      type="text"
      placeholder="Search pages, projects, actions…"
      aria-label="Search"
      aria-controls="command-list"
      autocomplete="off"
      spellcheck="false"
      class="h-14 w-full bg-transparent text-base outline-none placeholder:text-muted"
    />
    <kbd class="rounded border border-line px-1.5 py-0.5 text-xs text-muted">Esc</kbd>
  </div>
  <div id="command-list" role="listbox" class="max-h-[min(60vh,26rem)] overflow-y-auto p-2">
    {
      groups.map((g) => (
        <div data-group>
          <p class="px-3 pb-1 pt-3 text-xs font-medium text-muted">{g}</p>
          {items
            .filter((i) => i.group === g)
            .map((i) => (
              <a
                role="option"
                href={i.href ?? "#"}
                data-action={i.action}
                data-label={`${i.label} ${i.hint ?? ""}`.toLowerCase()}
                {...(i.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                class="flex items-center justify-between gap-4 rounded-lg px-3 py-2.5 text-[0.95rem] aria-selected:bg-ink aria-selected:text-paper"
              >
                <span>{i.label}</span>
                {i.hint && <span class="truncate text-sm opacity-60">{i.hint}</span>}
              </a>
            ))}
        </div>
      ))
    }
    <p data-empty hidden class="px-3 py-8 text-center text-muted">Nothing matches. Try “projects” or “email”.</p>
  </div>
</dialog>

<script>
  import { navigate } from "astro:transitions/client";

  function init() {
    const dlg = document.getElementById("command-menu") as HTMLDialogElement | null;
    if (!dlg) return;
    const input = dlg.querySelector("input")!;
    const options = [...dlg.querySelectorAll<HTMLAnchorElement>("[role=option]")];
    let visible = options;
    let index = 0;

    const select = (i: number) => {
      index = (i + visible.length) % visible.length;
      options.forEach((o) => o.removeAttribute("aria-selected"));
      const el = visible[index];
      if (el) {
        el.setAttribute("aria-selected", "true");
        el.scrollIntoView({ block: "nearest" });
      }
    };
    const filter = () => {
      const q = input.value.trim().toLowerCase();
      options.forEach((o) => (o.hidden = !!q && !o.dataset.label!.includes(q)));
      dlg.querySelectorAll<HTMLElement>("[data-group]").forEach((g) => {
        g.hidden = !g.querySelector("[role=option]:not([hidden])");
      });
      visible = options.filter((o) => !o.hidden);
      (dlg.querySelector("[data-empty]") as HTMLElement).hidden = visible.length > 0;
      select(0);
    };
    const open = () => {
      input.value = "";
      filter();
      dlg.showModal();
      input.focus();
    };
    const run = async (el: HTMLAnchorElement) => {
      const action = el.dataset.action;
      if (action === "copy-email") {
        await navigator.clipboard?.writeText(dlg.dataset.email ?? "").catch(() => {});
        el.querySelector("span")!.textContent = "Email copied";
        setTimeout(() => dlg.close(), 700);
        return;
      }
      if (action === "theme") {
        document.querySelector<HTMLButtonElement>("[data-theme-toggle]")?.click();
        dlg.close();
        return;
      }
      dlg.close();
      if (el.target === "_blank") window.open(el.href, "_blank", "noopener");
      else navigate(el.getAttribute("href")!);
    };

    input.oninput = filter;
    input.onkeydown = (e) => {
      if (e.key === "ArrowDown") (e.preventDefault(), select(index + 1));
      else if (e.key === "ArrowUp") (e.preventDefault(), select(index - 1));
      else if (e.key === "Enter" && visible[index]) (e.preventDefault(), run(visible[index]));
    };
    options.forEach((o) => {
      o.onclick = (e) => (e.preventDefault(), run(o));
      o.onmousemove = () => select(visible.indexOf(o));
    });
    // Click on the dimmed backdrop closes the menu
    dlg.onclick = (e) => e.target === dlg && dlg.close();

    document.querySelectorAll<HTMLButtonElement>("[data-open-command]").forEach((b) => (b.onclick = open));
    document.onkeydown = (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
        e.preventDefault();
        dlg.open ? dlg.close() : open();
      }
    };
  }
  document.addEventListener("astro:page-load", init);
</script>
