---
interface Props {
  name: string;
  size?: number;
  class?: string;
  [attr: string]: unknown;
}
const { name, size = 20, class: cls, ...rest } = Astro.props;

const stroke: Record<string, string> = {
  arrow: '<path d="M7 17 17 7M8 7h9v9"/>',
  "arrow-right": '<path d="M5 12h14m-6-6 6 6-6 6"/>',
  "arrow-left": '<path d="M19 12H5m6-6-6 6 6 6"/>',
